# Code d'accès à 4 chiffres (obligatoire). Ne commitez jamais le fichier .env.
APP_PIN=

# Derrière Caddy en HTTPS : laisser à 1.
# COOKIE_SECURE=1 : le cookie de session n'est envoyé qu'en HTTPS.
# TRUST_PROXY=1 : l'IP du client est lue dans l'en-tête X-Forwarded-For posé par Caddy
# (sûr parce que le conteneur n'écoute que sur 127.0.0.1).
COOKIE_SECURE=1
TRUST_PROXY=1
